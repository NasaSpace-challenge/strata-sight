# ============================================================================
# StrataSight Backend Environment Template (copy keys into backend/.env.local)
# ============================================================================

API_BACKEND_HOST=127.0.0.1
API_BACKEND_PORT=5000
API_PAYLOAD_MAX_SIZE=7mb

# 1. Google Cloud Vertex AI (for Gemini AI Climatologist Drawer)
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
PROXY_HEADER=x-stratasight-proxy

# 2. Google Earth Engine (/api/timeseries: MODIS NDVI, GPM IMERG V07, GLDAS, MERRA-2)
#    Paste your GCP Service Account JSON into backend/ee-service-account.json
EE_PROJECT_ID=your-gcp-project-id
EE_SERVICE_ACCOUNT_KEY_FILE=./ee-service-account.json

# 3. NASA Earthdata Login Bearer Token (Unlocks live NASA GES DISC Hydrology Data Rods
#    /api/earthdata/gesdisc-datarods & NASA LP DAAC AppEEARS point tasks)
#    Generate free at: https://urs.earthdata.nasa.gov/users/tokens
EARTHDATA_TOKEN=

# 4. NOAA NCEI Climate Data Online v2 Token (Unlocks /api/earthdata/noaa-cdo;
#    Note: /api/earthdata/noaa-ncei-gsom already works with zero token!)
#    Request free instant token by email at: https://www.ncei.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=

# 5. Optional cache directories (old EARTHPULSE_* names still work)
# STRATASIGHT_CACHE_DIR=../data-cache
# STRATASIGHT_SEED_DIR=./seed-cache
# STRATASIGHT_IMAGERY_DIR=./imagery-cache
