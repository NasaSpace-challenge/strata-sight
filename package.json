{
  "name": "stratasight-nasa-earth-science-trend-detective",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev-frontend": "npm run dev --prefix frontend",
    "dev-backend": "npm run dev --prefix backend",
    "dev": "concurrently \"npm run dev-frontend\" \"npm run dev-backend\"",
    "test": "npm run test --prefix frontend && npm run test --prefix backend",
    "typecheck": "cd frontend && ../node_modules/.bin/tsc -p .",
    "build": "npm run build --prefix frontend",
    "warm": "tsx --env-file-if-exists=backend/.env.local scripts/warm-cache.mts",
    "seed": "tsx --env-file-if-exists=backend/.env.local scripts/warm-cache.mts --seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15"
  }
}
